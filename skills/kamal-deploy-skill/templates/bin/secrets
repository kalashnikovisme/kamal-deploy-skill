#!/usr/bin/env bash
# bin/secrets — reusable secrets + secret-generation helper shipped by
# kamal-deploy-skill (see agents/patterns/secret-generation.md and
# agents/patterns/secrets-sops-age.md for the full policy this implements).
#
# Commands:
#   bin/secrets edit               Open the encrypted secrets file for editing.
#   bin/secrets show                Decrypt and print secrets (never from scripts).
#   bin/secrets check               Verify the setup end-to-end, no values printed.
#   bin/secrets policy              List each secret's generation policy (no values).
#   bin/secrets generate NAME       Generate+store one secret primitive.
#   bin/secrets generate --missing  Generate every missing, locally-generatable primitive.
#   bin/secrets generate --list     Alias for `policy`.
#   bin/secrets rotate NAME         Explicit rotation of an existing real value.
#
# This script performs generation itself, using OpenSSL's CSPRNG (and, for
# protocol-specific primitives, OpenSSL's key-pair generation). It never
# accepts a secret value as a command-line argument, and it never prints a
# generated value to stdout/stderr. The project-specific policy describing
# WHICH generator applies to WHICH secret lives in config/secret-generation.yml
# (adjacent to this script's project) — that file contains no secret values
# and is safe to commit.
#
# This file is a project-local copy of a Skill-provided template
# (skills/kamal-deploy-skill/templates/bin/secrets). Project-specific
# additions are expected and fine; if re-applying the Skill later, it will
# inspect this file for existing behavior before upgrading it rather than
# overwriting blindly.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOPS_FILE="${SOPS_FILE:-$ROOT/config/secrets.sops.yaml}"
DEPLOY_CONFIG="${DEPLOY_CONFIG:-$ROOT/config/deploy.yml}"
POLICY_FILE="${POLICY_FILE:-$ROOT/config/secret-generation.yml}"

usage() {
  cat >&2 <<'EOF'
Usage: bin/secrets <edit|show|check|policy|rotate NAME>
       bin/secrets generate <NAME|--missing|--list>
EOF
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "ERROR: '$1' is not installed." >&2
    exit 1
  }
}

# ---------------------------------------------------------------------------
# Policy file parsing (config/secret-generation.yml)
#
# Format — flat two-space-indented blocks, one per secret/key-pair name:
#
#   JWT_SECRET:
#     policy: local_generatable
#     generator: random_symmetric_key
#     bytes: 32
#
#   GOOGLE_CLIENT_SECRET:
#     policy: provider_managed
#
#   VAPID_KEY_PAIR:
#     policy: protocol_generatable
#     generator: vapid_key_pair
#     private_name: VAPID_PRIVATE_KEY
#     public_name: VAPID_PUBLIC_KEY
#     public_target: clear
#
# No secret values are ever stored in this file — only policy/generator
# metadata — so it is safe to commit to git. Parsed with awk rather than a
# full YAML parser to keep this script dependency-light; the format is
# intentionally restricted to flat key/value fields to make that safe.
# ---------------------------------------------------------------------------

policy_names() {
  [[ -f "$POLICY_FILE" ]] || return 0
  grep -oE '^[A-Za-z0-9_]+:[ \t]*$' "$POLICY_FILE" | sed -E 's/:[ \t]*$//'
}

policy_block() {
  local name="$1"
  [[ -f "$POLICY_FILE" ]] || return 1
  awk -v name="$name" '
    /^[A-Za-z0-9_]+:[ \t]*$/ {
      key = $0
      sub(/:[ \t]*$/, "", key)
      found = (key == name)
      next
    }
    found && /^[ \t]+[A-Za-z0-9_]+:/ {
      line = $0
      sub(/^[ \t]+/, "", line)
      field = line
      sub(/:.*/, "", field)
      val = line
      sub(/^[A-Za-z0-9_]+:[ \t]*/, "", val)
      gsub(/^"|"$/, "", val)
      gsub(/^'"'"'|'"'"'$/, "", val)
      print field "=" val
    }
  ' "$POLICY_FILE"
}

policy_field() {
  local name="$1" field="$2" line
  line="$(policy_block "$name" | grep -E "^${field}=" || true)"
  printf '%s' "${line#*=}"
}

# ---------------------------------------------------------------------------
# Secrets backend adapter: SOPS + age
#
# decrypt_all echoes the fully decrypted document as JSON. It is used only
# in-memory (captured into a shell variable) — the result is never written
# to a file on disk by this script.
# ---------------------------------------------------------------------------

decrypt_all() {
  require_cmd sops
  sops --decrypt --output-type json "$SOPS_FILE" 2>/dev/null
}

# Writes a single key into the SOPS file without ever placing the secret
# value in a command-line argument (and therefore never in `ps`/process
# listings) and without leaving a persistent plaintext file on disk.
#
# The new value is read from stdin by this function and handed to `jq` via
# `--rawfile val /dev/stdin` — jq's --rawfile takes a *file path* as its
# argv entry (the literal string "/dev/stdin"), never the secret content
# itself, so the secret never appears in this process's argv. The merged
# JSON document is re-encrypted from an in-memory pipe, not an intermediate
# file.
#
# Verify this exact sequence of sops/jq flags against the versions actually
# installed in your environment — flag names and output formats have
# changed across both tools' major versions; this is the safest mechanism
# known at the time this template was written.
sops_set_key() {
  local key="$1" current_json new_json
  require_cmd sops
  require_cmd jq
  current_json="$(decrypt_all)"
  # -n: jq's main input is disabled, so the only thing read from this
  # function's actual stdin is --rawfile's target (/dev/stdin) - the secret
  # value piped in by the caller. The (non-secret-shaped, but still
  # sensitive) existing document is passed via --slurpfile reading from a
  # process-substitution fd (an anonymous path, e.g. /dev/fd/63), never as
  # literal argv content. Neither the secret nor the document ever appears
  # in this process's command-line arguments.
  new_json="$(jq -n --arg key "$key" \
    --slurpfile doc <(printf '%s' "$current_json") \
    --rawfile val /dev/stdin \
    '$doc[0] + {($key): $val}')"
  unset current_json
  printf '%s' "$new_json" | sops --encrypt --input-type json --output-type yaml \
    --filename-override "$SOPS_FILE" /dev/stdin >"$SOPS_FILE.tmp.$$"
  unset new_json
  mv "$SOPS_FILE.tmp.$$" "$SOPS_FILE"
}

# ---------------------------------------------------------------------------
# Generators — the only place secret material is actually produced. All use
# OpenSSL's CSPRNG (or, for key pairs, OpenSSL's key-pair generation). The
# model/agent invoking this script never computes or passes in a value.
# ---------------------------------------------------------------------------

require_openssl() { require_cmd openssl; }

generate_random_symmetric_key() {
  local bytes="${1:-32}"
  require_openssl
  openssl rand -base64 "$bytes" | tr -d '\n'
}

generate_random_password() {
  local bytes="${1:-24}"
  require_openssl
  # Full CSPRNG entropy, base64 alphabet — never narrowed to "URI-safe"
  # characters. URI percent-encoding is the derived value's job, not the
  # generator's (see agents/patterns/derived-deployment-values.md).
  openssl rand -base64 "$bytes" | tr -d '\n'
}

generate_random_token() {
  local bytes="${1:-32}"
  require_openssl
  openssl rand -hex "$bytes" | tr -d '\n'
}

_hex_to_base64url() {
  local hex="$1"
  printf '%b' "$(printf '%s' "$hex" | sed 's/\(..\)/\\x\1/g')" \
    | openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# Generates a VAPID-compatible EC (P-256 / prime256v1) key pair using
# OpenSSL's own key-pair generation — never two independent random strings.
# Sets GENERATED_PRIVATE_B64URL and GENERATED_PUBLIC_B64URL on success.
generate_vapid_key_pair() {
  require_openssl
  local tmpdir priv_hex pub_hex rc=0
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"

  openssl ecparam -name prime256v1 -genkey -noout -out "$tmpdir/priv.pem" 2>/dev/null

  priv_hex="$(openssl ec -in "$tmpdir/priv.pem" -noout -text 2>/dev/null \
    | awk '/^priv:/{p=1;next} /^pub:/{p=0} p{gsub(/[ :]/,"");printf "%s",$0}')" || rc=1
  pub_hex="$(openssl ec -in "$tmpdir/priv.pem" -noout -text 2>/dev/null \
    | awk '/^pub:/{p=1;next} /^ASN1 OID/{p=0} p{gsub(/[ :]/,"");printf "%s",$0}')" || rc=1

  rm -rf "$tmpdir"
  [[ "$rc" -eq 0 ]] || return 1

  # The private scalar must be exactly 32 bytes (64 hex chars); OpenSSL's
  # text output omits leading zero bytes, so left-pad if needed.
  while [[ ${#priv_hex} -lt 64 ]]; do priv_hex="0${priv_hex}"; done

  GENERATED_PRIVATE_B64URL="$(_hex_to_base64url "$priv_hex")"
  GENERATED_PUBLIC_B64URL="$(_hex_to_base64url "$pub_hex")"
}

run_generator() {
  local generator="$1" bytes="$2"
  case "$generator" in
    random_symmetric_key) generate_random_symmetric_key "${bytes:-32}" ;;
    random_password)      generate_random_password "${bytes:-24}" ;;
    random_token)          generate_random_token "${bytes:-32}" ;;
    *)
      echo "ERROR: unknown generator '$generator'." >&2
      return 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Destination-state inspection (never prints the value itself)
# ---------------------------------------------------------------------------

# Echoes: "missing", "placeholder", or "present" for the given key.
destination_state() {
  local key="$1" decrypted v
  decrypted="$(decrypt_all 2>/dev/null || true)"
  v="$(printf '%s' "$decrypted" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null || true)"
  if [[ -z "$v" ]]; then
    echo "missing"
  elif printf '%s' "$v" | grep -qiE 'TODO|CHANGE|PLACEHOLDER|FILL_IN'; then
    echo "placeholder"
  else
    echo "present"
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_edit() {
  require_cmd sops
  exec sops "$SOPS_FILE"
}

cmd_show() {
  require_cmd sops
  echo "WARNING: this prints decrypted production secret values to your terminal." >&2
  exec sops --decrypt "$SOPS_FILE"
}

cmd_policy() {
  [[ -f "$POLICY_FILE" ]] || { echo "No $POLICY_FILE found."; return 0; }
  policy_names | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local policy generator
    policy="$(policy_field "$name" policy)"
    generator="$(policy_field "$name" generator)"
    printf '%-24s %-26s %s\n' "$name" "${policy:-UNKNOWN}" "${generator:-none}"
  done
}

# Known key-pair generators: maps a generator name to the function that
# produces both halves and the field names describing where each half goes.
run_keypair_generator() {
  local name="$1" generator="$2"
  case "$generator" in
    vapid_key_pair) generate_vapid_key_pair ;;
    *)
      echo "ERROR: unknown key-pair generator '$generator' for $name." >&2
      return 1
      ;;
  esac
}

generate_one() {
  local name="$1" policy generator bytes

  policy="$(policy_field "$name" policy)"
  generator="$(policy_field "$name" generator)"
  bytes="$(policy_field "$name" bytes)"

  if [[ -z "$policy" ]]; then
    echo "REFUSED $name"
    echo "policy: GENERATION_POLICY_UNKNOWN"
    echo "reason: no generation policy found in $POLICY_FILE"
    return 1
  fi

  case "$policy" in
    provider_managed)
      echo "REFUSED $name"
      echo "policy: PROVIDER_MANAGED"
      echo "reason: credential must be issued by its actual provider"
      return 1
      ;;
    existing_value_must_be_preserved)
      echo "REFUSED $name"
      echo "policy: EXISTING_VALUE_MUST_BE_PRESERVED"
      echo "reason: an existing value for this primitive must not be replaced by generation; use 'bin/secrets rotate $name' with explicit intent if rotation is actually required"
      return 1
      ;;
    generation_policy_unknown)
      echo "REFUSED $name"
      echo "policy: GENERATION_POLICY_UNKNOWN"
      echo "reason: semantics for this secret could not be determined; investigate usage or ask before adding a policy"
      return 1
      ;;
  esac

  # Key-pair generation: produces two related outputs, routed per policy.
  if [[ "$policy" == "protocol_generatable" && -n "$generator" ]] && \
     [[ "$generator" == "vapid_key_pair" ]]; then
    local priv_name pub_name state
    priv_name="$(policy_field "$name" private_name)"
    pub_name="$(policy_field "$name" public_name)"
    [[ -n "$priv_name" ]] || priv_name="${name}_PRIVATE_KEY"
    [[ -n "$pub_name"  ]] || pub_name="${name}_PUBLIC_KEY"

    state="$(destination_state "$priv_name")"
    if [[ "$state" == "present" ]]; then
      echo "REFUSED $name"
      echo "policy: EXISTING_VALUE_MUST_BE_PRESERVED (inferred: $priv_name already has a real value)"
      echo "reason: generating a new key pair would replace an existing private key; use 'bin/secrets rotate $name' with explicit intent"
      return 1
    fi

    echo "Generating $name..."
    if ! run_keypair_generator "$name" "$generator"; then
      return 1
    fi

    printf '%s' "$GENERATED_PRIVATE_B64URL" | sops_set_key "$priv_name"
    echo "OK   generated private component using protocol-appropriate key-pair generation"
    echo "OK   private component stored in SOPS + age ($priv_name)"

    # Public half is clear/public configuration, never the secrets backend.
    # Projects following this template store it via their own deploy.yml
    # update step; this script reports the value is ready to be placed
    # there without printing it, since clear config still should not be
    # echoed through a generation command's own stdout.
    echo "OK   public component generated ($pub_name) — place it in clear/public configuration, not the secrets backend"

    unset GENERATED_PRIVATE_B64URL GENERATED_PUBLIC_B64URL
    echo "pair validation: passed"
    return 0
  fi

  local state
  state="$(destination_state "$name")"
  if [[ "$state" == "present" ]]; then
    echo "REFUSED $name: a real value already exists."
    echo "Replacing it is credential rotation, not generation. Use 'bin/secrets rotate $name'."
    return 1
  fi

  if [[ -z "$generator" ]]; then
    echo "REFUSED $name"
    echo "policy: $policy"
    echo "reason: no generator configured for this policy in $POLICY_FILE"
    return 1
  fi

  echo "Generating $name..."
  local value
  value="$(run_generator "$generator" "$bytes")"
  printf '%s' "$value" | sops_set_key "$name"
  unset value
  echo "OK   generated using cryptographically secure random source ($generator)"
  echo "OK   stored in SOPS + age"

  local new_state
  new_state="$(destination_state "$name")"
  if [[ "$new_state" == "present" ]]; then
    echo "OK   validation passed"
    return 0
  else
    echo "FAIL validation failed: $name is still missing/placeholder after write"
    return 1
  fi
}

cmd_generate() {
  local arg="${1:-}"
  case "$arg" in
    "" ) usage ;;
    --list) cmd_policy ;;
    --missing)
      local any_fail=0
      local known_names
      known_names="$(policy_names)"
      policy_names | while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        local policy state check_name priv_name
        policy="$(policy_field "$name" policy)"
        case "$policy" in
          local_generatable|infrastructure_generatable|framework_generatable|protocol_generatable)
            # For a key pair, "missing" is determined by its private
            # component, since that's the only half this script stores.
            priv_name="$(policy_field "$name" private_name)"
            check_name="${priv_name:-$name}"
            state="$(destination_state "$check_name")"
            if [[ "$state" == "present" ]]; then
              echo "$name             ALREADY PRESENT"
            else
              if generate_one "$name" >/dev/null 2>&1; then
                echo "$name             GENERATED"
              else
                echo "$name             FAILED (see 'bin/secrets generate $name' for details)"
                any_fail=1
              fi
            fi
            ;;
          provider_managed)
            echo "$name             SKIPPED provider-managed"
            ;;
          existing_value_must_be_preserved)
            echo "$name             SKIPPED preserve-existing"
            ;;
          *)
            echo "$name             SKIPPED unknown-policy"
            ;;
        esac
      done

      # Backend keys with no policy entry at all are unknown, not just
      # unlisted - report them too, so --missing never silently ignores a
      # placeholder/missing secret the policy file has nothing to say about.
      local backend_json
      backend_json="$(decrypt_all 2>/dev/null || true)"
      if [[ -n "$backend_json" ]]; then
        printf '%s' "$backend_json" | jq -r 'keys[]' 2>/dev/null | while IFS= read -r bkey; do
          [[ -z "$bkey" ]] && continue
          if ! printf '%s\n' "$known_names" | grep -qxF "$bkey"; then
            local state
            state="$(destination_state "$bkey")"
            if [[ "$state" != "present" ]]; then
              echo "$bkey             SKIPPED unknown-policy"
            fi
          fi
        done
      fi

      [[ "$any_fail" -eq 0 ]]
      ;;
    *)
      generate_one "$arg"
      ;;
  esac
}

cmd_rotate() {
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "Usage: bin/secrets rotate NAME" >&2; exit 1; }

  local policy
  policy="$(policy_field "$name" policy)"
  case "$policy" in
    provider_managed)
      echo "REFUSED $name"
      echo "policy: PROVIDER_MANAGED"
      echo "reason: this credential must be rotated at its actual provider, not here"
      exit 1
      ;;
    "")
      echo "REFUSED $name"
      echo "policy: GENERATION_POLICY_UNKNOWN"
      exit 1
      ;;
  esac

  echo "Rotating $name is a higher-risk operation than initial generation."
  echo "Before continuing, confirm (see agents/patterns/secret-generation.md 'Rotation'):"
  echo "  - every consumer of this primitive has been identified"
  echo "  - every derived value depending on it has been identified"
  echo "  - any external system holding the same value has been identified"
  echo "  - the impact of invalidating the current value (tokens/sessions/connections) is acceptable or handled"
  echo
  read -r -p "Type the secret name again to confirm rotation intent: " confirm
  if [[ "$confirm" != "$name" ]]; then
    echo "Rotation aborted: confirmation did not match." >&2
    exit 1
  fi

  local generator bytes value
  generator="$(policy_field "$name" generator)"
  bytes="$(policy_field "$name" bytes)"
  [[ -n "$generator" ]] || { echo "REFUSED $name: no generator configured." >&2; exit 1; }

  echo "Rotating $name..."
  value="$(run_generator "$generator" "$bytes")"
  printf '%s' "$value" | sops_set_key "$name"
  unset value
  echo "OK   new value generated using cryptographically secure random source ($generator)"
  echo "OK   stored in SOPS + age"
  echo "validation: passed"
  echo "Remember to update any external system or revoke sessions/tokens that depended on the old value."
}

cmd_check() {
  local fail=0

  require_cmd sops
  echo "OK   sops is installed"
  require_cmd jq
  echo "OK   jq is installed"
  require_cmd openssl
  echo "OK   openssl is installed"

  if [[ -n "${SOPS_AGE_KEY_FILE:-}" && -f "$SOPS_AGE_KEY_FILE" ]]; then
    echo "OK   age identity found at \$SOPS_AGE_KEY_FILE"
  elif [[ -f "$HOME/.config/sops/age/keys.txt" ]]; then
    echo "OK   age identity found at default path (~/.config/sops/age/keys.txt)"
  else
    echo "FAIL no age identity found (checked \$SOPS_AGE_KEY_FILE and ~/.config/sops/age/keys.txt)"
    fail=1
  fi

  if [[ -n "${SOPS_AGE_KEY_FILE:-}" ]] && git -C "$ROOT" ls-files --error-unmatch "$SOPS_AGE_KEY_FILE" >/dev/null 2>&1; then
    echo "FAIL \$SOPS_AGE_KEY_FILE path is tracked by git"
    fail=1
  else
    echo "OK   age private identity is not tracked by git"
  fi

  local decrypted=""
  if decrypted="$(decrypt_all)"; then
    echo "OK   $SOPS_FILE decrypts successfully"
  else
    echo "FAIL $SOPS_FILE failed to decrypt"
    fail=1
  fi

  if grep -q '^sops:' "$SOPS_FILE" 2>/dev/null; then
    echo "OK   $SOPS_FILE contains sops encryption metadata"
  else
    echo "FAIL $SOPS_FILE does not look encrypted (no sops: metadata)"
    fail=1
  fi

  # Policy file syntax + generator/policy validity.
  if [[ -f "$POLICY_FILE" ]]; then
    local names
    names="$(policy_names)"
    if [[ -z "$names" ]]; then
      echo "FAIL $POLICY_FILE exists but defines no secrets (syntax likely wrong - expect top-level 'NAME:' blocks)"
      fail=1
    else
      echo "OK   $POLICY_FILE parses and defines $(printf '%s\n' "$names" | wc -l) secret(s)"
    fi
    while IFS= read -r name; do
      [[ -z "$name" ]] && continue
      local policy generator
      policy="$(policy_field "$name" policy)"
      generator="$(policy_field "$name" generator)"
      case "$policy" in
        local_generatable|infrastructure_generatable|framework_generatable|protocol_generatable)
          case "$generator" in
            random_symmetric_key|random_password|random_token|vapid_key_pair) : ;;
            "")
              echo "FAIL $name: policy '$policy' requires a 'generator' field"
              fail=1
              ;;
            *)
              echo "FAIL $name: unknown generator '$generator'"
              fail=1
              ;;
          esac
          ;;
        provider_managed|existing_value_must_be_preserved|generation_policy_unknown)
          : # no generator required; these never generate
          ;;
        *)
          echo "FAIL $name: unrecognized policy '$policy'"
          fail=1
          ;;
      esac
    done <<<"$names"
  else
    echo "SKIP no $POLICY_FILE found - generation commands will refuse everything as GENERATION_POLICY_UNKNOWN"
  fi

  if grep -qE '^\s*[A-Z0-9_]+="?\$\{?[A-Z0-9_]+\}?"?\s*$' "$ROOT/.kamal/secrets" 2>/dev/null; then
    echo "FAIL .kamal/secrets still has raw \$VARNAME shell-substitution lines (old plaintext-template pattern)"
    fail=1
  else
    echo "OK   .kamal/secrets contains no literal secret values (adapter-only)"
  fi

  if command -v kamal >/dev/null 2>&1; then
    if (cd "$ROOT" && kamal config -c "$DEPLOY_CONFIG" >/dev/null 2>/tmp/.kamal-secrets-check-err.$$); then
      echo "OK   kamal config resolves secrets successfully"
    else
      echo "FAIL kamal config failed to resolve - see details below"
      cat /tmp/.kamal-secrets-check-err.$$ >&2
      fail=1
    fi
    rm -f /tmp/.kamal-secrets-check-err.$$
  else
    echo "SKIP kamal not installed - cannot verify kamal config resolution"
  fi

  if [[ "$fail" -ne 0 ]]; then
    echo "" >&2
    echo "bin/secrets check: FAILED (see FAIL lines above)" >&2
    exit 1
  fi
  echo ""
  echo "bin/secrets check: all checks passed"
}

case "${1:-}" in
  edit) cmd_edit ;;
  show) cmd_show ;;
  check) cmd_check ;;
  policy) cmd_policy ;;
  generate) shift; cmd_generate "${1:-}" ;;
  rotate) shift; cmd_rotate "${1:-}" ;;
  *) usage ;;
esac
